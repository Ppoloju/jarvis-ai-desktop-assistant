# Port the API listens on
PORT=5000

# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: storage root for files, screenshots and reminders (defaults to the server folder)
# ORBIT_DATA_DIR=/absolute/path/to/data

# Optional: home folder used by the read-only Desktop, Documents and Downloads browser
# ORBIT_HOME=/absolute/path/to/home
