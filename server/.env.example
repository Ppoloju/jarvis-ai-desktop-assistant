# Port the API listens on
PORT=5000

# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: storage root for files, screenshots and reminders (defaults to the server folder)
# ORBIT_DATA_DIR=/absolute/path/to/data

# Optional: home folder used by the read-only Desktop, Documents and Downloads browser
# ORBIT_HOME=/absolute/path/to/home

# Optional: interface the API binds to (defaults to loopback)
# HOST=127.0.0.1

# Optional: local free-form chat through Ollama, with no key. Orbit detects it on this port
# and uses an installed model; a model picked in Settings overrides OLLAMA_MODEL.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Optional: a remote OpenAI-compatible provider. An AI key takes priority over the local model.
# AI_API_KEY=your_key_here
# AI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_MODEL=glm-4-flash
